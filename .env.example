HOST=127.0.0.1
PORT=3100
DATA_DIR=.data
DEMO_MODE=true
# Seed six editable examples for each new local demo account. No model key needed.
DEMO_EXAMPLES=true
# Browser and headless Office runtime license. Use .env.local for local values.
UNIVER_CLIENT_LICENSE=
# Optional Collaboration/Exchange server license pair; never sent to the browser.
UNIVER_LICENSE=
UNIVER_LICENSE_KEY=
# Optional local demo model. Copy to .env.local and fill in your own key there.
# Only enabled in loopback DEMO_MODE=true; the key is never sent to the browser.
DEEPSEEK_API_KEY=
# Initial model for a new DeepSeek profile; existing profiles stay editable in chat.
DEEPSEEK_MODEL=
# Initial reasoning level: off / low / high / max. Existing profiles stay editable.
DEEPSEEK_REASONING_EFFORT=
# Legacy fallback when DEEPSEEK_REASONING_EFFORT is unset.
DEEPSEEK_THINKING=
